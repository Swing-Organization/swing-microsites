{
  "name": "swing-microsites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs campaigns/*/tests/unit/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs campaigns/*/tests/unit/*.test.mjs",
    "media": "node campaigns/swing-x-john-montgomery/scripts/prepare-media.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit-output.mjs",
    "check": "npm run test:unit && npm run build && npm run audit && npm run test:e2e",
    "media:restore": "node scripts/deployment/restore-media.mjs",
    "build:deployment": "npm run media:restore && node scripts/deployment/build.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "parse5": "8.0.1",
    "sharp": "0.35.4"
  }
}
